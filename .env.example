NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Supabase — Project Settings > API in your Supabase dashboard.
# The anon key is safe for the browser. NEVER put the service role key
# behind a NEXT_PUBLIC_ prefix or reference it from client-side code —
# it bypasses all Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dropbox — https://www.dropbox.com/developers/apps, your app's Settings tab.
# App must have ONLY files.metadata.read and files.content.read permissions.
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/callback

# Random 32-byte base64 key for encrypting the stored Dropbox refresh token.
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=generate-your-own-32-byte-base64-key

# Optional. Restricts syncing to a specific Dropbox folder instead of the
# whole account, e.g. "/Research Archive". Leave blank to sync everything.
DROPBOX_SYNC_ROOT_PATH=

# Optional, needed only when a scheduled sync job (e.g. Vercel Cron) is
# configured later. Lets /api/dropbox/sync be called without an admin
# browser session. Generate the same way as TOKEN_ENCRYPTION_KEY.
CRON_SECRET=generate-your-own-random-secret

# Stephen's Podcast Studio (see docs/podcast-studio-setup.md)
# The 4-digit studio passcode. Choose your own; never commit or share it.
PODCAST_STUDIO_PASSCODE=
# Random secret (32+ characters) used to sign the studio login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PODCAST_STUDIO_SESSION_SECRET=
# Daily.co (video room + cloud recording) — https://dashboard.daily.co > Developers > API keys
DAILY_API_KEY=
# YouTube copy (site owner only; Stephen never touches this). Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=https://YOUR-SITE-DOMAIN/api/podcast-studio/youtube/callback
# Publishing to /media commits to GitHub using the same settings as the admin panel:
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
GITHUB_BRANCH=main
