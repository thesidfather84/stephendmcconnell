NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Supabase — Project Settings > API in your Supabase dashboard.
# The anon key is safe for the browser. NEVER put the service role key
# behind a NEXT_PUBLIC_ prefix or reference it from client-side code —
# it bypasses all Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
